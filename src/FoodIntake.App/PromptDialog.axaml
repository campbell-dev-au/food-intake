<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="FoodIntake.App.PromptDialog"
        Width="340" SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Title="Enter a name">
  <StackPanel Margin="16">
    <TextBlock Name="MessageText" TextWrapping="Wrap" Margin="0,0,0,8"/>
    <TextBox Name="ValueBox" />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button Content="Cancel" Click="OnCancelClick"/>
      <Button Content="OK" Click="OnOkClick" Margin="6,0,0,0" IsDefault="True"/>
    </StackPanel>
  </StackPanel>
</Window>
