<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="FoodIntake.App.ConfirmDialog"
        Width="320" SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Title="Confirm">
  <StackPanel Margin="16">
    <TextBlock Name="MessageText" TextWrapping="Wrap"/>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button Content="Cancel" Click="OnCancelClick"/>
      <Button Content="Clear" Click="OnConfirmClick" Margin="6,0,0,0"/>
    </StackPanel>
  </StackPanel>
</Window>
