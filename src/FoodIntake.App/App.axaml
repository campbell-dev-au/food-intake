<Application xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  x:Class="FoodIntake.App.App"
  RequestedThemeVariant="Default">
  <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available
  options. -->

  <Application.Styles>
    <FluentTheme />

    <Style Selector="TextBlock.status">
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Margin" Value="0,0,0,4" />
    </Style>
    <Style Selector="TextBlock.status.error">
      <Setter Property="Foreground" Value="#C0392B" />
    </Style>
    <Style Selector="TextBlock.status.success">
      <Setter Property="Foreground" Value="#2E7D32" />
    </Style>

  </Application.Styles>
</Application>
